# Скопируйте этот файл в .env и заполните значениями из вашего проекта Supabase
# (Project Settings -> API). Переменные с префиксом EXPO_PUBLIC_ доступны в коде
# приложения через process.env — это публичные значения (anon key защищён RLS),
# секретные ключи (service_role) сюда добавлять нельзя.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Если .env отсутствует или переменные не заполнены, приложение автоматически
# работает в локальном демо-режиме (данные из src/data, без сохранения между
# перезапусками) — так, как оно работало до подключения Supabase.
